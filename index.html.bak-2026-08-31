  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --teal:        #1C4A52;
      --teal-dark:   #102F35;
      --teal-light:  #2F6B76;
      --olive:       #5C6B32;
      --olive-dark:  #45521F;
      --olive-light: #93A75E;
      --dark:        #0E2327;
      --gray-900:    #1B2E2E;
      --gray-800:    #35504E;
      --gray-600:    #5C7876;
      --gray-400:    #93A9A7;
      --gray-200:    #DDE7E6;
      --gray-100:    #EEF4F3;
      --gray-50:     #FAFBFB;
      --white:       #FFFFFF;
      --text:        #16302F;
      --text-light:  #52706D;
      --line:        rgba(28,74,82,0.14);
    }

    html { scroll-behavior: smooth; overflow-x: hidden; scroll-padding-top: 90px; }
    body {
      font-family: 'Inter', sans-serif;
      color: var(--text);
      background: var(--white);
      overflow-x: hidden;
      line-height: 1.65;
      opacity: 0;
      transition: opacity 0.5s ease;
      font-size: 16px;
    }
    body.loaded { opacity: 1; }
    img { max-width: 100%; height: auto; display: block; }
    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }

    .container { width: 100%; max-width: 1220px; margin: 0 auto; padding: 0 32px; }
    .container-narrow { width: 100%; max-width: 760px; margin: 0 auto; padding: 0 32px; }

    :focus-visible {
      outline: 2px solid var(--olive);
      outline-offset: 3px;
    }

    /* ===== HEADER ===== */
    header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      background: rgba(255,255,255,0.97);
      border-bottom: 1px solid var(--line);
      transition: box-shadow 0.3s;
    }
    header.scrolled { box-shadow: 0 2px 20px rgba(16,47,53,0.06); }

    .header-inner {
      display: flex; align-items: center; justify-content: space-between;
      height: 90px; gap: 24px;
    }

    .logo-link { display: flex; align-items: center; gap: 12px; }
    .logo-link img { height: 40px; width: auto; object-fit: contain; }
    .logo-text { display: flex; flex-direction: column; line-height: 1.2; }
    .logo-text strong { font-family: 'Poppins', sans-serif; font-size: 1.05rem; font-weight: 700; color: var(--teal); letter-spacing: -0.01em; }
    .logo-text span { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--olive); }

    nav { display: flex; align-items: center; gap: 6px; }
    nav a {
      position: relative;
      font-size: 0.82rem; font-weight: 500; letter-spacing: 0.02em; color: var(--gray-800);
      padding: 8px 15px;
      transition: color 0.2s;
      white-space: nowrap;
    }
    nav a:not(.nav-vitrine):not(.btn-nav)::after {
      content: ''; position: absolute; left: 15px; right: 15px; bottom: 4px;
      height: 1px; background: var(--olive);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.3s ease;
    }
    nav a:hover { color: var(--teal); }
    nav a:not(.nav-vitrine):not(.btn-nav):hover::after,
    nav a.nav-active:not(.nav-vitrine):not(.btn-nav)::after { transform: scaleX(1); }
    nav a.nav-active:not(.btn-nav) { color: var(--teal); }

    .btn-nav {
      background: var(--teal); color: var(--white) !important;
      padding: 10px 22px;
      font-weight: 600; font-size: 0.82rem; letter-spacing: 0.02em;
      transition: background 0.2s;
      margin-left: 8px;
    }
    .btn-nav:hover { background: var(--teal-dark); color: var(--white) !important; }

    .nav-vitrine {
      display: inline-flex; align-items: center; gap: 7px;
      color: var(--olive) !important;
      font-weight: 600 !important;
    }
    .nav-vitrine svg { width: 14px; height: 14px; flex-shrink: 0; }
    .nav-vitrine:hover { color: var(--olive-dark) !important; }
    .mobile-nav .nav-vitrine { justify-content: center; }

    .menu-toggle {
      display: none; flex-direction: column; gap: 5px;
      cursor: pointer; padding: 6px; border: none; background: none;
    }
    .menu-toggle span {
      display: block; width: 22px; height: 1.5px;
      background: var(--teal); transition: all 0.3s;
    }

    .mobile-nav {
      display: none; position: fixed; top: 90px; left: 0; right: 0;
      background: var(--white); padding: 8px 24px 24px;
      border-bottom: 1px solid var(--line);
      z-index: 999;
    }
    .mobile-nav.open { display: flex; flex-direction: column; }
    .mobile-nav a {
      padding: 14px 4px; font-weight: 500; color: var(--text);
      border-bottom: 1px solid var(--gray-100);
    }
    .mobile-nav a.nav-active:not(.btn-nav) { color: var(--teal); }
    .mobile-nav .btn-nav {
      margin-top: 16px; text-align: center; border-bottom: none;
      background: var(--teal); color: var(--white) !important;
    }

    /* ===== HERO ===== */
    .hero {
      position: relative; min-height: 100vh;
      display: flex; align-items: flex-end; padding-top: 90px;
      background-image: url('assets/img/hero-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
      overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(14,35,39,0.72) 0%, rgba(14,35,39,0.55) 40%, rgba(14,35,39,0.90) 100%);
      z-index: 0;
    }
    .hero-content { position: relative; z-index: 1; max-width: 760px; padding: 64px 0 88px; }

    .hero-eyebrow {
      display: flex; align-items: center; gap: 12px;
      color: rgba(255,255,255,0.75);
      font-size: 0.76rem; font-weight: 600; letter-spacing: 0.16em;
      text-transform: uppercase; margin-bottom: 26px;
    }
    .hero-eyebrow::before { content: ''; width: 32px; height: 1px; background: var(--olive-light); }

    .hero h1 {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(2.8rem, 7.2vw, 5.6rem);
      font-weight: 700; color: var(--white); line-height: 1.02; margin-bottom: 22px;
      letter-spacing: -0.02em;
    }

    .hero-slogan {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.05rem, 1.6vw, 1.3rem); font-style: italic; font-weight: 400;
      color: var(--olive-light); margin-bottom: 24px; max-width: 560px;
    }

    .hero h2 {
      font-size: clamp(1rem, 1.6vw, 1.15rem); font-weight: 400;
      color: rgba(255,255,255,0.82); margin-bottom: 44px; max-width: 600px; line-height: 1.7;
    }

    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; margin-bottom: 64px; }

    .btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--olive); color: var(--white);
      padding: 15px 30px;
      font-weight: 600; font-size: 0.92rem;
      transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--olive-dark); }

    .link-arrow {
      display: inline-flex; align-items: center; gap: 8px;
      color: var(--white); font-weight: 500; font-size: 0.92rem;
      padding-bottom: 2px; border-bottom: 1px solid rgba(255,255,255,0.4);
      transition: border-color 0.2s, gap 0.2s;
    }
    .link-arrow:hover { border-color: rgba(255,255,255,0.9); gap: 12px; }
    .link-arrow svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .hero-stats { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid rgba(255,255,255,0.18); padding-top: 32px; }
    .stat-item { display: flex; flex-direction: column; padding: 0 36px 0 0; margin-right: 36px; border-right: 1px solid rgba(255,255,255,0.18); }
    .stat-item:last-child { border-right: none; margin-right: 0; padding-right: 0; }
    .stat-num {
      font-family: 'Poppins', sans-serif; font-size: 2.6rem;
      font-weight: 700; color: var(--white); line-height: 1; letter-spacing: -0.01em;
    }
    .stat-num span { color: var(--olive-light); }
    .stat-label { font-size: 0.76rem; color: rgba(255,255,255,0.62); margin-top: 6px; max-width: 150px; }

    /* ===== SEÇÕES ===== */
    section { padding: 128px 0; }

    .eyebrow {
      display: flex; align-items: center; gap: 12px; width: max-content;
      font-size: 0.76rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--olive); margin-bottom: 20px;
    }
    .eyebrow::before { content: ''; width: 28px; height: 1px; background: var(--olive); }
    .section-header.center .eyebrow { margin-left: auto; margin-right: auto; }

    .section-title {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(2rem, 4.2vw, 3.4rem);
      font-weight: 700; color: var(--gray-900); line-height: 1.1; margin-bottom: 22px;
      letter-spacing: -0.015em;
    }
    .section-title em { font-style: italic; font-family: 'Fraunces', serif; font-weight: 400; color: var(--olive); }

    .section-subtitle {
      font-size: 1.02rem; color: var(--text-light); max-width: 600px; line-height: 1.8;
    }
    .section-header { margin-bottom: 72px; }
    .section-header.center { text-align: center; }
    .section-header.center .section-subtitle { margin: 0 auto; }

    /* ===== SOBRE ===== */
    .sobre-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 88px; align-items: center; }

    .sobre-img-wrap { position: relative; }
    .sobre-img-wrap img { width: 100%; height: 480px; object-fit: cover; display: block; }
    .sobre-caption {
      display: flex; align-items: baseline; gap: 14px; margin-top: 18px;
    }
    .sobre-caption strong { font-family: 'Fraunces', serif; font-style: italic; font-size: 1.6rem; color: var(--olive); }
    .sobre-caption span { font-size: 0.82rem; color: var(--text-light); }

    .sobre-text p { margin-bottom: 20px; color: var(--text-light); }
    .sobre-text .section-subtitle { max-width: none; margin-bottom: 20px; color: var(--text); font-size: 1.08rem; }
    .sobre-text strong { color: var(--text); }

    /* ===== NÚMEROS EM CHIP ===== */
    .num-chip {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 38px; height: 38px; padding: 0 8px; flex-shrink: 0;
      background: var(--olive); color: var(--white);
      font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.85rem;
      border-radius: 4px;
    }

    /* ===== MISSÃO, VISÃO E VALORES ===== */
    .missao-visao { background: var(--dark); }
    .missao-visao .eyebrow { color: var(--olive-light); }
    .missao-visao .eyebrow::before { background: var(--olive-light); }
    .missao-visao .section-title { color: var(--white); }
    .missao-visao .section-subtitle { color: rgba(255,255,255,0.62); }

    .mv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: 88px; border-top: 1px solid rgba(255,255,255,0.14); }
    .mv-card {
      padding: 44px 48px 0 0;
    }
    .mv-card + .mv-card { padding-left: 48px; border-left: 1px solid rgba(255,255,255,0.14); }
    .mv-num { display: flex; align-items: center; gap: 14px; font-family: 'Poppins', sans-serif; font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.7); letter-spacing: 0.10em; text-transform: uppercase; margin-bottom: 22px; padding-top: 32px; }
    .mv-card h3 { font-family: 'Poppins', sans-serif; font-size: 1.5rem; font-weight: 700; color: var(--white); margin-bottom: 14px; }
    .mv-card p { font-size: 0.98rem; color: rgba(255,255,255,0.6); line-height: 1.8; }

    .valores-grid { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid rgba(255,255,255,0.14); }
    .valor-card {
      padding: 32px 24px 0 0; border-right: 1px solid rgba(255,255,255,0.14);
    }
    .valor-card:last-child { border-right: none; }
    .valor-num { margin-bottom: 18px; }
    .valor-card h4 { font-size: 0.98rem; font-weight: 700; color: var(--white); margin-bottom: 8px; }
    .valor-card p { font-size: 0.85rem; color: rgba(255,255,255,0.55); line-height: 1.7; }

    /* ===== SERVIÇOS ===== */
    .servicos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line); }
    .servico-panel { padding: 48px 56px 0 0; }
    .servico-panel + .servico-panel { padding-left: 56px; border-left: 1px solid var(--line); }
    .servico-num { margin-bottom: 22px; margin-top: 40px; }
    .servico-panel h3 { font-family: 'Poppins', sans-serif; font-size: 1.6rem; font-weight: 700; color: var(--gray-900); margin-bottom: 14px; }
    .servico-panel > p { font-size: 0.98rem; color: var(--text-light); line-height: 1.75; margin-bottom: 36px; }

    .servico-list { display: flex; flex-direction: column; }
    .servico-list li {
      display: flex; gap: 18px; align-items: flex-start;
      padding: 22px 0; border-top: 1px solid var(--gray-100);
    }
    .servico-list li:last-child { border-bottom: 1px solid var(--gray-100); }
    .servico-list .tick { flex-shrink: 0; width: 15px; height: 15px; margin-top: 4px; color: var(--olive); }
    .servico-list strong { display: block; font-size: 0.96rem; font-weight: 700; color: var(--gray-900); margin-bottom: 3px; }
    .servico-list span { font-size: 0.86rem; color: var(--text-light); line-height: 1.6; }

    /* ===== SOFTWARE / DIFERENCIAL EOCUPACIONAL ===== */
    .software {
      position: relative; overflow: hidden;
      background-image: url('assets/img/software-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
    }
    .software::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(10,18,20,0.86); z-index: 0;
    }
    .software .container { position: relative; z-index: 1; }
    .software .eyebrow { color: var(--olive-light); }
    .software .eyebrow::before { background: var(--olive-light); }
    .software .section-header { max-width: 740px; }
    .software .section-title { color: var(--white); }
    .software .section-subtitle { color: rgba(255,255,255,0.68); }

    .software-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,0.16); }
    .software-card { padding: 36px 32px 0 0; }
    .software-card + .software-card { padding-left: 32px; border-left: 1px solid rgba(255,255,255,0.16); }
    .software-num { margin-bottom: 20px; margin-top: 28px; }
    .software-card h4 { font-family: 'Poppins', sans-serif; font-size: 1.15rem; font-weight: 700; color: var(--white); margin-bottom: 12px; }
    .software-card p { font-size: 0.88rem; color: rgba(255,255,255,0.62); line-height: 1.7; }

    /* ===== DIFERENCIAIS ===== */
    .diff-list { border-top: 1px solid var(--line); }
    .diff-row {
      display: grid; grid-template-columns: 90px 1fr 1.6fr; gap: 32px; align-items: center;
      padding: 32px 0; border-bottom: 1px solid var(--line);
      transition: background 0.2s;
    }
    .diff-row:hover { background: var(--gray-50); }
    .diff-row h4 { font-size: 1.1rem; font-weight: 700; color: var(--gray-900); }
    .diff-row p { font-size: 0.92rem; color: var(--text-light); line-height: 1.7; }

    /* ===== VITRINE CTA ===== */
    .vitrine-cta { background: var(--olive); padding: 72px 0; }
    .vitrine-box {
      display: flex; align-items: center; justify-content: space-between; gap: 44px;
    }
    .vitrine-content h3 { font-family: 'Poppins', sans-serif; font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 700; color: var(--white); margin-bottom: 12px; letter-spacing: -0.01em; }
    .vitrine-content p { font-size: 0.98rem; color: rgba(255,255,255,0.78); line-height: 1.75; max-width: 520px; }
    .btn-outline-dark {
      display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0;
      background: var(--white); color: var(--olive-dark);
      padding: 16px 32px; border: 1px solid var(--white);
      font-weight: 700; font-size: 0.92rem;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .btn-outline-dark:hover { background: transparent; color: var(--white); border-color: var(--white); }
    .btn-outline-dark svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    @media (max-width: 768px) {
      .vitrine-box { flex-direction: column; align-items: flex-start; gap: 28px; }
    }

    /* ===== CONTATO ===== */
    .contato-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 88px; align-items: start; }

    .contato-info-list { display: flex; flex-direction: column; margin-top: 40px; border-top: 1px solid var(--line); }
    .contato-item { display: flex; gap: 20px; align-items: flex-start; padding: 22px 0; border-bottom: 1px solid var(--line); }

    .contato-icon {
      flex-shrink: 0; width: 20px; height: 20px; margin-top: 2px;
      color: var(--olive);
    }
    .contato-icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

    .contato-item-text strong {
      display: block; font-size: 0.72rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em; color: var(--gray-600); margin-bottom: 5px;
    }
    .contato-item-text span, .contato-item-text a { font-size: 0.98rem; color: var(--text); line-height: 1.5; }
