      });
    });
    document.querySelectorAll('.sobre-grid > div, .mv-card, .valor-card, .servico-panel, .software-card, .vitrine-box, .contato-info-list, .contato-form').forEach(el => revObs.observe(el));

    // Zoom sutil (ken burns) na imagem da seção Sobre conforme a rolagem
    (function() {
      const wrap = document.querySelector('.sobre-img-wrap');
      const img  = wrap ? wrap.querySelector('img') : null;
      if (!wrap || !img || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      img.style.transition = 'transform 0.2s linear';
      img.style.willChange = 'transform';
      function update() {
        const r = wrap.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = 1 - Math.min(Math.max((r.top + r.height / 2) / (vh + r.height), 0), 1);
        img.style.transform = `scale(${1 + progress * 0.1})`;
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    })();

    // Active nav conforme seção visível
    (function() {
      const secs     = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('nav a[href^="#"], .mobile-nav a[href^="#"]');
      function setActive(id) {
        navLinks.forEach(a => {
          a.classList.toggle('nav-active', a.getAttribute('href') === '#' + id);
        });
      }
      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) setActive(e.target.id); });
      }, { threshold: 0.35 });
      secs.forEach(s => obs.observe(s));
    })();
  </script>
</body>
</html>
