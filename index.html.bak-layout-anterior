  <script>
    // Fade-in inicial da página
    document.body.classList.add('loaded');

    // Scroll progress
    const bar = document.getElementById('scroll-progress');
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
    }, { passive: true });

    // Voltar ao topo
    const backToTop = document.getElementById('backToTop');
    window.addEventListener('scroll', () => {
      backToTop.classList.toggle('visible', window.scrollY > 700);
    }, { passive: true });
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Header shadow
    const header = document.getElementById('header');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });

    // Mobile menu
    const toggle = document.getElementById('menuToggle');
    const mNav   = document.getElementById('mobileNav');
    const spans  = toggle.querySelectorAll('span');
    toggle.addEventListener('click', () => {
      const open = mNav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open);
      if (open) {
        spans[0].style.cssText = 'transform:rotate(45deg) translate(5px,5px)';
        spans[1].style.cssText = 'opacity:0;transform:scaleX(0)';
        spans[2].style.cssText = 'transform:rotate(-45deg) translate(5px,-5px)';
      } else {
        spans.forEach(s => s.style.cssText = '');
      }
    });
    document.querySelectorAll('.mobile-link').forEach(l => {
      l.addEventListener('click', () => {
        mNav.classList.remove('open');
        spans.forEach(s => s.style.cssText = '');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });

    // Formulário → WhatsApp
    document.getElementById('contactForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const nome     = document.getElementById('nome').value.trim();
      const telefone = document.getElementById('telefone').value.trim();
      const assunto  = document.getElementById('assunto').value;
      const mensagem = document.getElementById('mensagem').value.trim();
      if (!nome || !telefone) { alert('Por favor, preencha nome e telefone.'); return; }
      const labels = {
        'pcmso-pgr': 'PCMSO / PGR para minha empresa', 'exame': 'Agendar exame ocupacional',
        'eocupacional': 'Conhecer o sistema eOcupacional', 'outro': 'Outro assunto'
      };
      let msg = `Olá! Vim pelo site e gostaria de saber mais.\n\n`;
      msg += `*Nome:* ${nome}\n*Telefone:* ${telefone}\n`;
      if (assunto)  msg += `*Assunto:* ${labels[assunto] || assunto}\n`;
      if (mensagem) msg += `\n*Mensagem:* ${mensagem}`;
      window.open(`https://wa.me/5524998741257?text=${encodeURIComponent(msg)}`, '_blank');
    });

    // Count-up
    function countUp(el) {
      const m = el.textContent.trim().match(/^(\d+)/);
      if (!m || parseInt(m[1]) < 3) return;
      const target = parseInt(m[1]);
      const rest   = el.innerHTML.replace(/^\d+/, '');
      const dur = 1600, t0 = performance.now();
      function ease(t) { return 1 - Math.pow(1 - t, 4); }
      (function tick(now) {
        const p = Math.min((now - t0) / dur, 1);
        el.innerHTML = Math.round(ease(p) * target) + rest;
        if (p < 1) requestAnimationFrame(tick);
      })(t0);
    }
    const numObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { countUp(e.target); numObs.unobserve(e.target); } });
    }, { threshold: 0.4 });
    document.querySelectorAll('.stat-num').forEach(el => numObs.observe(el));

    // Scroll reveal
    const revealConfig = [
      { sel: '.section-header',      dir: 'up' },
      { sel: '.mv-card',             dir: 'up',   stagger: true },
      { sel: '.valor-card',          dir: 'up',   stagger: true },
      { sel: '.diff-card',           dir: 'up',   stagger: true },
      { sel: '.software-card',       dir: 'up',   stagger: true },
      { sel: '.vitrine-box',         dir: 'up' },
      { sel: '.contato-info-list',   dir: 'left' },
      { sel: '.contato-form',        dir: 'right' },
      { sel: '.footer-brand',        dir: 'up' },
      { sel: '.footer-col',          dir: 'up',   stagger: true },
    ];
    const delays = ['','delay-1','delay-2','delay-3','delay-4','delay-5','delay-6','delay-7'];
    const revObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); revObs.unobserve(e.target); } });
    }, { threshold: 0.12 });
    revealConfig.forEach(({ sel, dir, stagger }) => {
      document.querySelectorAll(sel).forEach((el, i) => {
        el.classList.add('reveal-' + dir);
        if (stagger && delays[i % delays.length]) el.classList.add(delays[i % delays.length]);
        revObs.observe(el);
      });
    });
    document.querySelectorAll('.sobre-img-wrap, .sobre-text, .servico-panel').forEach(el => revObs.observe(el));

    // Section title underline
    const titleObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('line-active'); titleObs.unobserve(e.target); } });
    }, { threshold: 0.5 });
    document.querySelectorAll('.section-title').forEach(el => titleObs.observe(el));

    // Ripple nos botões
    document.querySelectorAll('.btn-primary, .btn-outline, .btn-submit, .btn-nav').forEach(btn => {
      btn.classList.add('btn-ripple');
      btn.addEventListener('click', function(e) {
        const r = btn.getBoundingClientRect();
        const size = Math.max(r.width, r.height) * 2;
        const span = document.createElement('span');
        span.className = 'ripple-circle';
        span.style.cssText = `width:${size}px;height:${size}px;left:${e.clientX - r.left - size/2}px;top:${e.clientY - r.top - size/2}px`;
        btn.appendChild(span);
        setTimeout(() => span.remove(), 600);
      });
    });

    // Active nav conforme seção visível
    (function() {
      const secs     = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('nav a[href^="#"], .mobile-nav a[href^="#"]');
      function setActive(id) {
        navLinks.forEach(a => {
          a.classList.toggle('nav-active', a.getAttribute('href') === '#' + id);
        });
      }
      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) setActive(e.target.id); });
      }, { threshold: 0.35 });
      secs.forEach(s => obs.observe(s));
    })();

    var hasTouch = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Typewriter no hero h2
    (function() {
      const h2 = document.querySelector('.hero h2');
      if (!h2 || prefersReducedMotion) return;
      const text = h2.textContent.trim();
      h2.textContent = '';
      h2.style.animation = 'none';
      h2.style.opacity = '1';
      h2.style.transform = 'none';
      let i = 0;
      function type() {
        if (i < text.length) { h2.textContent += text[i++]; setTimeout(type, 9); }
      }
      setTimeout(type, 1300);
    })();

    // Spotlight do mouse no hero
    (function() {
      const hero = document.querySelector('.hero');
      const spot = document.getElementById('heroSpotlight');
      if (!hero || !spot || hasTouch || prefersReducedMotion) return;
      hero.addEventListener('mousemove', e => {
        const r = hero.getBoundingClientRect();
        spot.style.left = (e.clientX - r.left) + 'px';
        spot.style.top  = (e.clientY - r.top) + 'px';
        spot.classList.add('active');
      });
      hero.addEventListener('mouseleave', () => spot.classList.remove('active'));
    })();

    // Botões magnéticos (desktop apenas)
    if (!hasTouch) document.querySelectorAll('.btn-primary, .btn-outline').forEach(btn => {
      btn.classList.add('btn-magnetic');
      btn.addEventListener('mousemove', e => {
        btn.classList.remove('settling');
        const r = btn.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) * 0.28;
        const y = (e.clientY - r.top - r.height / 2) * 0.35;
        btn.style.transform = `translate(${x}px, ${y}px)`;
      });
      btn.addEventListener('mouseleave', () => {
        btn.classList.add('settling');
        btn.style.transform = '';
      });
    });

    // Tilt 3D nos cards (desktop apenas)
    if (!hasTouch) document.querySelectorAll('.diff-card, .servico-panel, .software-card, .mv-card').forEach(card => {
      card.addEventListener('mousemove', function(e) {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width  - 0.5;
        const y = (e.clientY - r.top)  / r.height - 0.5;
        card.style.transform = `perspective(700px) rotateY(${x * 7}deg) rotateX(${-y * 5}deg) translateZ(6px)`;
        card.style.transition = 'transform 0.08s ease';
      });
      card.addEventListener('mouseleave', function() {
        card.style.transition = 'transform 0.45s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s, border-color 0.2s, background 0.3s';
        card.style.transform = '';
      });
    });

    // Zoom sutil (ken burns) na imagem da seção Sobre conforme a rolagem
    (function() {
      const wrap = document.querySelector('.sobre-img-wrap');
      const img  = wrap ? wrap.querySelector('img') : null;
      if (!wrap || !img || prefersReducedMotion) return;
      function update() {
        const r = wrap.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = 1 - Math.min(Math.max((r.top + r.height / 2) / (vh + r.height), 0), 1);
        img.style.transform = `scale(${1 + progress * 0.12})`;
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    })();
  </script>
