  <!-- HEADER -->
  <header id="header">
    <div class="container">
      <div class="header-inner">
        <a href="#inicio" class="logo-link" aria-label="Clínica Modea - Início">
          <img src="assets/img/logo-icon.png" alt="Clínica Modea — Logo" fetchpriority="high">
          <span class="logo-text"><strong>Clínica Modea</strong><span>Saúde ocupacional</span></span>
        </a>
        <nav aria-label="Menu principal">
          <a href="#inicio">Início</a>
          <a href="#sobre">Sobre</a>
          <a href="#servicos">Serviços</a>
          <a href="#diferenciais">Diferenciais</a>
