  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --teal:        #1C4A52;
      --teal-dark:   #102F35;
      --teal-light:  #2F6B76;
      --teal-pale:   #EAF2F2;
      --olive:       #5C6B32;
      --olive-dark:  #45521F;
      --olive-light: #93A75E;
      --dark:        #0E2327;
      --dark-2:      #123338;
      --gray-900:    #1B2E2E;
      --gray-800:    #35504E;
      --gray-600:    #5C7876;
      --gray-400:    #93A9A7;
      --gray-200:    #DDE7E6;
      --gray-100:    #EEF4F3;
      --gray-50:     #F7FAFA;
      --white:       #FFFFFF;
      --text:        #16302F;
      --text-light:  #52706D;
    }

    html { scroll-behavior: smooth; overflow-x: hidden; scroll-padding-top: 96px; }
    body {
      font-family: 'Inter', sans-serif;
      color: var(--text);
      background: var(--white);
      overflow-x: hidden;
      line-height: 1.6;
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    body.loaded { opacity: 1; }
    img { max-width: 100%; height: auto; display: block; }
    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }

    .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    :focus-visible {
      outline: 3px solid var(--olive-light);
      outline-offset: 3px;
      border-radius: 2px;
    }

    /* ===== SCROLL PROGRESS ===== */
    #scroll-progress {
      position: fixed; top: 0; left: 0; z-index: 99999;
      height: 3px; width: 0%;
      background: linear-gradient(90deg, var(--teal-light), var(--olive));
      pointer-events: none;
    }

    /* ===== HEADER ===== */
    header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(28,74,82,0.08);
      transition: box-shadow 0.3s;
    }
    header.scrolled { box-shadow: 0 4px 20px rgba(28,74,82,0.10); }

    .header-inner {
      display: flex; align-items: center; justify-content: space-between;
      height: 88px; gap: 16px;
    }

    .logo-link { display: flex; align-items: center; gap: 12px; transition: opacity 0.2s; }
    .logo-link:hover { opacity: 0.85; }
    .logo-link img { height: 52px; width: auto; object-fit: contain; }
    .logo-text { display: flex; flex-direction: column; line-height: 1.15; }
    .logo-text strong { font-family: 'Poppins', sans-serif; font-size: 1.15rem; font-weight: 800; color: var(--teal); letter-spacing: -0.01em; }
    .logo-text span { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--olive); }

    nav { display: flex; align-items: center; gap: 2px; }
    nav a {
      position: relative;
      font-size: 0.875rem; font-weight: 500; color: var(--gray-900);
      padding: 8px 13px; border-radius: 7px;
      transition: color 0.2s, background 0.2s; white-space: nowrap;
    }
    nav a:hover { color: var(--teal); background: rgba(28,74,82,0.08); }
    nav a:not(.btn-nav)::after {
      content: ''; position: absolute; left: 13px; right: 13px; bottom: 4px;
      height: 2px; background: var(--olive); border-radius: 2px;
      transform: scaleX(0); transform-origin: center;
      transition: transform 0.28s cubic-bezier(0.22,1,0.36,1);
    }
    nav a:not(.btn-nav):hover::after,
    nav a.nav-active:not(.btn-nav)::after { transform: scaleX(1); }
    nav a.nav-active:not(.btn-nav) { color: var(--teal); }

    .btn-nav {
      background: var(--olive); color: var(--white) !important;
      padding: 9px 20px; border-radius: 50px;
      font-weight: 600; font-size: 0.875rem;
      transition: background 0.2s, transform 0.15s !important;
    }
    .btn-nav:hover { background: var(--olive-dark); color: var(--white) !important; transform: translateY(-1px); }

    .nav-vitrine {
      display: inline-flex; align-items: center; gap: 7px;
      border: 1.5px solid var(--teal) !important;
      color: var(--teal) !important;
      padding: 6.5px 16px !important;
      border-radius: 50px;
      transition: background 0.2s, color 0.2s !important;
    }
    .nav-vitrine::after { content: none !important; }
    .nav-vitrine svg { width: 14px; height: 14px; flex-shrink: 0; }
    .nav-vitrine:hover,
    .nav-vitrine.nav-active { background: var(--teal); color: var(--white) !important; }
    .mobile-nav .nav-vitrine { justify-content: center; }

    .menu-toggle {
      display: none; flex-direction: column; gap: 5px;
      cursor: pointer; padding: 6px; border: none; background: none;
    }
    .menu-toggle span {
      display: block; width: 24px; height: 2px;
      background: var(--teal); border-radius: 2px; transition: all 0.3s;
    }

    .mobile-nav {
      display: none; position: fixed; top: 88px; left: 0; right: 0;
      background: var(--white); padding: 16px 24px 24px;
      border-bottom: 1px solid var(--gray-200);
      box-shadow: 0 8px 24px rgba(28,74,82,0.09); z-index: 999;
    }
    .mobile-nav.open { display: flex; flex-direction: column; gap: 4px; }
    .mobile-nav a {
      padding: 12px 16px; font-weight: 500; color: var(--text);
      border-radius: 8px; transition: background 0.2s, color 0.2s;
    }
    .mobile-nav a:hover { background: var(--gray-100); color: var(--teal); }
    .mobile-nav a.nav-active:not(.btn-nav) { color: var(--teal); background: var(--gray-100); }
    .mobile-nav .btn-nav {
      margin-top: 8px; text-align: center;
      background: var(--olive); color: var(--white) !important;
    }

    /* ===== HERO ===== */
    .hero {
      position: relative; min-height: 100vh;
      display: flex; align-items: center; padding-top: 88px;
      background-image: url('assets/img/hero-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
      overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg,
        rgba(14,35,39,0.95) 0%,
        rgba(28,74,82,0.90) 45%,
        rgba(92,107,50,0.42) 100%);
      z-index: 0;
    }
    .hero-spotlight {
      position: absolute; top: 0; left: 0; z-index: 0;
      width: 480px; height: 480px; border-radius: 50%;
      background: radial-gradient(circle, rgba(147,167,94,0.20), rgba(47,107,118,0.10) 55%, transparent 75%);
      transform: translate(-50%, -50%); pointer-events: none;
      opacity: 0; transition: opacity 0.4s ease; will-change: transform;
    }
    .hero-spotlight.active { opacity: 1; }

    .hero-content { position: relative; z-index: 1; max-width: 700px; padding: 48px 0; }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.28);
      color: rgba(255,255,255,0.90); padding: 6px 16px; border-radius: 50px;
      font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; margin-bottom: 20px;
    }

    .hero h1 {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(2rem, 4.2vw, 3.2rem);
      font-weight: 800; color: var(--white); line-height: 1.15; margin-bottom: 14px;
    }

    .hero-slogan {
      font-size: 0.98rem; font-weight: 700; font-style: italic; letter-spacing: 0.01em;
      color: var(--olive-light); margin-bottom: 18px; max-width: 540px;
    }

    .hero h2 {
      font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 400;
      color: rgba(255,255,255,0.85); margin-bottom: 36px; max-width: 600px;
    }

    .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }

    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--olive); color: var(--white);
      padding: 14px 28px; border-radius: 50px;
      font-weight: 700; font-size: 1rem;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-primary:hover { background: var(--olive-dark); transform: translateY(-2px); }

    .btn-outline {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.10); color: var(--white);
      padding: 14px 28px; border-radius: 50px; font-weight: 600; font-size: 1rem;
      border: 1.5px solid rgba(255,255,255,0.55);
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }
    .btn-outline:hover {
      background: rgba(255,255,255,0.22); border-color: rgba(255,255,255,0.8);
      transform: translateY(-2px);
    }

    .hero-stats {
      display: flex; flex-wrap: wrap; gap: 28px; margin-top: 52px;
    }
    .stat-item { display: flex; flex-direction: column; }
    .stat-num {
      font-family: 'Poppins', sans-serif; font-size: 1.9rem;
      font-weight: 800; color: var(--white); line-height: 1;
    }
    .stat-num span { color: var(--olive-light); }
    .stat-label { font-size: 0.78rem; color: rgba(255,255,255,0.68); margin-top: 4px; max-width: 170px; }

    /* ===== SEÇÕES ===== */
    section { padding: 88px 0; }

    .section-tag {
      display: block; width: max-content; font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.10em; text-transform: uppercase;
      color: var(--teal); background: rgba(28,74,82,0.08);
      padding: 5px 14px; border-radius: 50px; margin-bottom: 14px;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .section-tag:hover { background: rgba(28,74,82,0.16); transform: translateY(-1px); }
    .section-header.center .section-tag { margin-left: auto; margin-right: auto; }

    .section-title {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 800; color: var(--gray-900); line-height: 1.25; margin-bottom: 16px;
      position: relative; display: inline-block;
    }
    .section-title span { color: var(--olive); }
    .section-title::after {
      content: ''; position: absolute; bottom: -8px; left: 0;
      height: 3px; width: 0;
      background: linear-gradient(90deg, var(--olive-light), var(--olive));
      border-radius: 3px; transition: width 0.9s cubic-bezier(0.22,1,0.36,1) 0.2s;
    }
    .section-title.line-active::after { width: 56px; }
    .section-header.center .section-title::after { left: 50%; transform: translateX(-50%); }

    .section-subtitle {
      font-size: 1.02rem; color: var(--text-light); max-width: 620px; line-height: 1.75;
    }
    .section-header { margin-bottom: 56px; }
    .section-header.center { text-align: center; }
    .section-header.center .section-subtitle { margin: 0 auto; }

    /* ===== SOBRE ===== */
    .sobre {
      position: relative; overflow: hidden;
      background-image: url('assets/img/sobre-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
    }
    .sobre::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(255,255,255,0.94); z-index: 0;
    }
    .sobre .container { position: relative; z-index: 1; }
    .sobre-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }

    .sobre-img-wrap { position: relative; border-radius: 20px; overflow: hidden; background: var(--gray-100); }
    .sobre-img-wrap img { width: 100%; height: 460px; object-fit: cover; display: block; transform: scale(1); transition: transform 0.2s linear; will-change: transform; }
    .sobre-img-overlay {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: linear-gradient(to top, rgba(14,35,39,0.92), transparent);
      padding: 28px; display: flex; align-items: flex-end;
    }
    .sobre-badge {
      background: var(--olive-light); color: var(--dark);
      padding: 12px 20px; border-radius: 16px; text-align: center;
      animation: floatY 3.6s ease-in-out infinite;
    }
    .sobre-badge strong { display: block; font-family: 'Poppins', sans-serif; font-size: 1.7rem; font-weight: 800; line-height: 1; }
    .sobre-badge span { font-size: 0.76rem; }

    .sobre-text p { margin-bottom: 16px; }
    .sobre-text .section-subtitle { max-width: none; margin-bottom: 16px; }

    /* ===== MISSÃO, VISÃO E VALORES ===== */
    .missao-visao {
      position: relative; overflow: hidden;
      background-image: url('assets/img/missao-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
    }
    .missao-visao::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(14,35,39,0.93); z-index: 0;
    }
    .missao-visao .container { position: relative; z-index: 1; }
    .missao-visao .section-tag { background: rgba(255,255,255,0.12); color: var(--olive-light); }
    .missao-visao .section-tag:hover { background: rgba(255,255,255,0.20); }
    .missao-visao .section-title { color: var(--white); }
    .missao-visao .section-subtitle { color: rgba(255,255,255,0.72); }

    .mv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-bottom: 48px; }
    .mv-card {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.14);
      border-radius: 20px; padding: 36px;
      transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
    }
    .mv-card:hover { background: rgba(255,255,255,0.09); border-color: rgba(147,167,94,0.5); transform: translateY(-3px); }
    .mv-card-icon {
      width: 50px; height: 50px; border-radius: 16px; margin-bottom: 18px;
      background: var(--olive); display: flex; align-items: center; justify-content: center;
    }
    .mv-card-icon svg { width: 24px; height: 24px; color: var(--white); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .mv-card h3 { font-family: 'Poppins', sans-serif; font-size: 1.2rem; font-weight: 800; color: var(--white); margin-bottom: 12px; }
    .mv-card p { font-size: 0.92rem; color: rgba(255,255,255,0.74); line-height: 1.75; }

    .valores-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; }
    .valor-card {
      flex: 1 1 200px; max-width: 230px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.11);
      border-radius: 16px; padding: 22px; position: relative; overflow: hidden;
      transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    }
    .valor-card::after {
      content: ''; position: absolute; top: 0; left: -120%;
      width: 55%; height: 100%;
      background: linear-gradient(115deg, transparent, rgba(255,255,255,0.08), transparent);
      transform: skewX(-18deg); pointer-events: none;
    }
    .valor-card:hover { background: rgba(255,255,255,0.08); border-color: rgba(147,167,94,0.55); transform: translateY(-4px); }
    .valor-card:hover::after { animation: shimmer 0.55s ease forwards; }
    .valor-icon {
      width: 42px; height: 42px; border-radius: 12px; position: relative;
      background: rgba(147,167,94,0.16); display: flex; align-items: center; justify-content: center;
      margin-bottom: 14px; transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), background 0.3s;
    }
    .valor-card:hover .valor-icon { background: var(--olive-light); transform: rotate(-8deg) scale(1.08); }
    .valor-card:hover .valor-icon svg { color: var(--dark); }
    .valor-icon svg { width: 20px; height: 20px; color: var(--olive-light); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: color 0.3s; }
    .valor-card h4 { font-size: 0.92rem; font-weight: 700; color: var(--white); margin-bottom: 6px; }
    .valor-card p { font-size: 0.82rem; color: rgba(255,255,255,0.64); line-height: 1.65; }

    /* ===== SERVIÇOS ===== */
    .servicos {
      position: relative; overflow: hidden;
      background-image: url('assets/img/servicos-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
    }
    .servicos::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(247,250,250,0.92); z-index: 0;
    }
    .servicos .container { position: relative; z-index: 1; }

    .servicos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .servico-panel {
      background: var(--white); border: 1px solid var(--gray-200); border-radius: 22px;
      padding: 36px; transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }
    .servico-panel:hover { border-color: var(--olive-light); box-shadow: 0 10px 30px rgba(28,74,82,0.10); transform: translateY(-3px); }
    .servico-icon {
      width: 54px; height: 54px; border-radius: 16px; margin-bottom: 20px;
      background: var(--teal); display: flex; align-items: center; justify-content: center;
    }
    .servico-icon svg { width: 26px; height: 26px; color: var(--white); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .servico-panel h3 { font-family: 'Poppins', sans-serif; font-size: 1.3rem; font-weight: 800; color: var(--gray-900); margin-bottom: 10px; }
    .servico-panel > p { font-size: 0.92rem; color: var(--text-light); line-height: 1.7; margin-bottom: 24px; }

    .servico-list { display: flex; flex-direction: column; gap: 16px; }
    .servico-list li { display: flex; gap: 12px; align-items: flex-start; }
    .servico-list .check-icon {
      flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%;
      background: rgba(92,107,50,0.12); display: flex; align-items: center; justify-content: center;
      margin-top: 1px;
    }
    .servico-list .check-icon svg { width: 13px; height: 13px; color: var(--olive); fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
    .servico-list strong { display: block; font-size: 0.92rem; font-weight: 700; color: var(--gray-900); }
    .servico-list span { font-size: 0.84rem; color: var(--text-light); line-height: 1.55; }

    /* ===== SOFTWARE / DIFERENCIAL EOCUPACIONAL ===== */
    .software {
      position: relative; overflow: hidden;
      background-image: url('assets/img/software-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
    }
    .software::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(14,23,26,0.90); z-index: 0;
    }
    .software .container { position: relative; z-index: 1; }
    .software .section-tag { background: rgba(255,255,255,0.12); color: var(--olive-light); }
    .software .section-tag:hover { background: rgba(255,255,255,0.20); }
    .software .section-header { max-width: 720px; }
    .software .section-title { color: var(--white); }
    .software .section-subtitle { color: rgba(255,255,255,0.75); }

    .software-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 40px; }
    .software-card {
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
      border-radius: 18px; padding: 28px; position: relative; overflow: hidden;
      transition: background 0.3s, border-color 0.3s, transform 0.3s;
    }
    .software-card::after {
      content: ''; position: absolute; top: 0; left: -120%;
      width: 55%; height: 100%;
      background: linear-gradient(115deg, transparent, rgba(255,255,255,0.09), transparent);
      transform: skewX(-18deg); pointer-events: none;
    }
    .software-card:hover { background: rgba(255,255,255,0.10); border-color: rgba(147,167,94,0.5); transform: translateY(-3px); }
    .software-card:hover::after { animation: shimmer 0.55s ease forwards; }
    .software-icon {
      width: 48px; height: 48px; border-radius: 14px; margin-bottom: 18px;
      background: var(--olive); display: flex; align-items: center; justify-content: center;
    }
    .software-icon svg { width: 23px; height: 23px; color: var(--white); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .software-card h4 { font-family: 'Poppins', sans-serif; font-size: 1.05rem; font-weight: 700; color: var(--white); margin-bottom: 10px; }
    .software-card p { font-size: 0.86rem; color: rgba(255,255,255,0.68); line-height: 1.65; }

    /* ===== DIFERENCIAIS ===== */
    .diferenciais {
      position: relative; overflow: hidden;
      background-image: url('assets/img/diferenciais-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
    }
    .diferenciais::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(247,250,250,0.92); z-index: 0;
    }
    .diferenciais .container { position: relative; z-index: 1; }
    .diff-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

    .diff-card {
      display: flex; gap: 16px; padding: 24px;
      border-radius: 16px; background: var(--white);
      border: 1px solid var(--gray-200);
      transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
      position: relative; overflow: hidden;
    }
    .diff-card::after {
      content: ''; position: absolute; top: 0; left: -120%;
      width: 55%; height: 100%;
      background: linear-gradient(115deg, transparent, rgba(147,167,94,0.12), transparent);
      transform: skewX(-18deg); pointer-events: none;
    }
    .diff-card:hover { border-color: var(--olive); box-shadow: 0 8px 28px rgba(92,107,50,0.16); transform: translateY(-2px); }
    .diff-card:hover::after { animation: shimmer 0.55s ease forwards; }

    .diff-icon {
      flex-shrink: 0; width: 46px; height: 46px; border-radius: 14px;
      background: rgba(28,74,82,0.08); display: flex; align-items: center; justify-content: center;
      transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), background 0.3s;
    }
    .diff-card:hover .diff-icon { transform: rotate(-8deg) scale(1.08); background: var(--olive); }
    .diff-card:hover .diff-icon svg { color: var(--white); }
    .diff-icon svg { width: 22px; height: 22px; color: var(--teal); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: color 0.3s; }

    .diff-text h4 { font-weight: 700; font-size: 0.9rem; color: var(--gray-900); margin-bottom: 5px; }
    .diff-text p { font-size: 0.82rem; color: var(--text-light); line-height: 1.65; }

    /* ===== VITRINE CTA ===== */
    .vitrine-cta { position: relative; overflow: hidden; }
    .vitrine-box {
      display: flex; align-items: center; gap: 44px;
      background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
      border-radius: 24px; padding: 48px; position: relative; overflow: hidden;
    }
    .vitrine-box::after {
      content: ''; position: absolute; top: 0; left: -130%; z-index: 1;
      width: 60%; height: 100%;
      background: linear-gradient(115deg, transparent, rgba(255,255,255,0.10), transparent);
      transform: skewX(-18deg); pointer-events: none;
    }
    .vitrine-box:hover::after { animation: shimmer 0.8s ease forwards; }
    .vitrine-icon {
      flex-shrink: 0; width: 88px; height: 88px; border-radius: 24px;
      background: rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center;
      position: relative; z-index: 2;
    }
    .vitrine-icon svg { width: 40px; height: 40px; color: var(--white); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .vitrine-content { position: relative; z-index: 2; }
    .vitrine-content h3 { font-family: 'Poppins', sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--white); margin-bottom: 10px; }
    .vitrine-content p { font-size: 0.95rem; color: rgba(255,255,255,0.78); line-height: 1.7; max-width: 520px; margin-bottom: 26px; }
    .btn-white {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--white); color: var(--teal);
      padding: 13px 28px; border-radius: 50px;
      font-weight: 700; font-size: 0.95rem;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-white:hover { background: var(--olive-light); color: var(--teal-dark); transform: translateY(-2px); }
    .btn-white svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    @media (max-width: 768px) {
      .vitrine-box { flex-direction: column; text-align: center; padding: 36px 24px; gap: 24px; }
      .vitrine-content p { margin-left: auto; margin-right: auto; }
    }

    /* ===== CONTATO ===== */
    .contato {
      position: relative; overflow: hidden;
      background-image: url('assets/img/contato-bg.jpg');
      background-size: cover; background-position: center; background-attachment: fixed;
    }
    .contato::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(247,250,250,0.93); z-index: 0;
    }
    .contato .container { position: relative; z-index: 1; }
    .contato-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }

    .contato-info-list { display: flex; flex-direction: column; gap: 20px; margin-top: 32px; }
    .contato-item { display: flex; gap: 16px; align-items: flex-start; transition: transform 0.25s ease; }
    .contato-item:hover { transform: translateX(4px); }

    .contato-icon {
      flex-shrink: 0; width: 46px; height: 46px; border-radius: 14px;
      background: rgba(28,74,82,0.08); display: flex; align-items: center; justify-content: center;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    .contato-item:hover .contato-icon { background: var(--olive); transform: scale(1.08) rotate(-6deg); }
    .contato-item:hover .contato-icon svg { color: var(--white); }
    .contato-icon svg { width: 20px; height: 20px; color: var(--teal); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: color 0.25s ease; }

    .contato-item-text strong {
      display: block; font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.07em; color: var(--teal); margin-bottom: 4px;
    }
    .contato-item-text span, .contato-item-text a { font-size: 0.95rem; color: var(--text); line-height: 1.5; }
    .contato-item-text a:hover { color: var(--olive); }

    .mapa-wrap { margin-top: 28px; border-radius: 16px; overflow: hidden; border: 1px solid var(--gray-200); height: 220px; }
    .mapa-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }

    .contato-form {
      background: var(--white); border-radius: 22px;
      padding: 40px 36px; border: 1px solid var(--gray-200);
    }
    .contato-form h3 {
      font-family: 'Poppins', sans-serif; font-size: 1.25rem;
      font-weight: 700; color: var(--gray-900); margin-bottom: 6px;
    }
    .contato-form > p { font-size: 0.875rem; color: var(--text-light); margin-bottom: 28px; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
    .form-group label { font-size: 0.78rem; font-weight: 600; color: var(--gray-800); }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 12px 16px; border-radius: 10px;
      border: 1.5px solid var(--gray-200); background: var(--white);
      font-family: 'Inter', sans-serif; font-size: 0.9rem; color: var(--text);
      transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; outline: none; width: 100%;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--olive); box-shadow: 0 0 0 3px rgba(92,107,50,0.14); transform: translateY(-2px);
    }
    .form-group textarea { resize: vertical; min-height: 100px; }

    .btn-submit {
      width: 100%; padding: 14px; background: var(--olive); color: var(--white);
      border: none; border-radius: 50px; font-family: 'Inter', sans-serif;
      font-size: 1rem; font-weight: 700; cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .btn-submit:hover { background: var(--olive-dark); transform: translateY(-1px); }
    .btn-submit svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* ===== FOOTER ===== */
    footer { background: var(--dark); color: rgba(255,255,255,0.70); padding: 60px 0 0; }

    .footer-grid {
      display: grid; grid-template-columns: 2fr 1fr 1fr 1.4fr;
      gap: 40px; padding-bottom: 48px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .footer-brand .footer-logo {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--white); padding: 10px 16px; border-radius: 12px; margin-bottom: 16px;
    }
    .footer-brand .footer-logo img { height: 38px; width: auto; }
    .footer-brand .footer-logo strong { font-family: 'Poppins', sans-serif; font-size: 1rem; font-weight: 800; color: var(--teal); }
    .footer-brand p { font-size: 0.875rem; line-height: 1.75; max-width: 280px; margin-bottom: 20px; color: rgba(255,255,255,0.55); }

    .footer-social { display: flex; gap: 10px; }
    .footer-social a {
      width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.08);
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s, transform 0.2s;
    }
    .footer-social a:hover { background: var(--olive); transform: translateY(-2px); }
    .footer-social a svg { width: 18px; height: 18px; color: var(--white); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .footer-col h4 {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.10em; color: var(--white); margin-bottom: 18px;
    }
    .footer-col { min-width: 0; }
    .footer-col ul { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .footer-col ul li a { display: inline-flex; align-items: center; font-size: 0.875rem; color: rgba(255,255,255,0.55); transition: color 0.2s, gap 0.2s; min-width: 0; white-space: normal; overflow-wrap: break-word; }
    .footer-col ul li a::before {
      content: '›'; display: inline-block; width: 0; opacity: 0; overflow: hidden;
      color: var(--olive-light); transition: width 0.22s ease, opacity 0.22s ease;
    }
    .footer-col ul li a:hover::before { width: 12px; opacity: 1; }
    .footer-col ul li a:hover { color: var(--olive-light); }

    .footer-contact-item { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 12px; }
    .footer-contact-item svg { width: 15px; height: 15px; color: var(--olive-light); flex-shrink: 0; margin-top: 2px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .footer-contact-item span, .footer-contact-item a { font-size: 0.83rem; color: rgba(255,255,255,0.60); line-height: 1.55; }
    .footer-contact-item a:hover { color: var(--olive-light); }

    .footer-bottom {
      padding: 20px 0; display: flex; flex-wrap: wrap;
      justify-content: space-between; align-items: center;
      gap: 12px; font-size: 0.78rem; color: rgba(255,255,255,0.35);
    }

    /* ===== WHATSAPP FLUTUANTE ===== */
    .wa-float {
      position: fixed; bottom: 28px; right: 28px; z-index: 9000;
      width: 56px; height: 56px; border-radius: 50%;
      background: #25D366; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 16px rgba(37,211,102,0.40);
      transition: box-shadow 0.2s, transform 0.15s;
    }
    .wa-float:hover { box-shadow: 0 6px 24px rgba(37,211,102,0.58); transform: scale(1.05); }
    .wa-float svg { width: 30px; height: 30px; fill: var(--white); }

    /* ===== VOLTAR AO TOPO ===== */
    .back-to-top {
      position: fixed; bottom: 28px; right: 96px; z-index: 8999;
      width: 44px; height: 44px; border-radius: 50%;
      background: var(--teal); border: 1px solid rgba(255,255,255,0.15);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 14px rgba(14,35,39,0.25);
      opacity: 0; visibility: hidden; transform: translateY(10px);
      transition: opacity 0.25s, transform 0.25s, visibility 0.25s, background 0.2s;
    }
    .back-to-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }
    .back-to-top:hover { background: var(--olive); }
    .back-to-top svg { width: 18px; height: 18px; color: var(--white); fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

    /* ===== EFEITOS ===== */
    @keyframes shimmer      { from { left: -120%; } to { left: 220%; } }
    @keyframes heroFadeUp   { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
    @keyframes heroFadeLeft { from { opacity: 0; transform: translateX(-22px); } to { opacity: 1; transform: none; } }
    @keyframes floatY       { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }

    .btn-ripple { position: relative; overflow: hidden; }
    .ripple-circle {
      position: absolute; border-radius: 50%; pointer-events: none;
      background: rgba(255,255,255,0.32);
      transform: scale(0); animation: rippleAnim 0.55s ease-out forwards;
    }
    @keyframes rippleAnim { to { transform: scale(4); opacity: 0; } }

    .hero-badge      { animation: heroFadeLeft 0.75s cubic-bezier(0.22,1,0.36,1) 0.20s both; }
    .hero-content h1 { animation: heroFadeUp   0.80s cubic-bezier(0.22,1,0.36,1) 0.38s both; }
    .hero-slogan     { animation: heroFadeUp   0.80s cubic-bezier(0.22,1,0.36,1) 0.50s both; }
    .hero-content h2 { animation: heroFadeUp   0.80s cubic-bezier(0.22,1,0.36,1) 0.62s both; }
    .hero-actions    { animation: heroFadeUp   0.80s cubic-bezier(0.22,1,0.36,1) 0.76s both; }
    .hero-stats      { animation: heroFadeUp   0.80s cubic-bezier(0.22,1,0.36,1) 0.90s both; }

    .reveal-up    { opacity: 0; transform: translateY(32px); transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1); }
    .reveal-left  { opacity: 0; transform: translateX(-40px); transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1); }
    .reveal-right { opacity: 0; transform: translateX(40px);  transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1); }
    .revealed { opacity: 1 !important; transform: none; }
    .delay-1 { transition-delay: 0.08s !important; }
    .delay-2 { transition-delay: 0.16s !important; }
    .delay-3 { transition-delay: 0.24s !important; }
    .delay-4 { transition-delay: 0.32s !important; }
    .delay-5 { transition-delay: 0.40s !important; }
    .delay-6 { transition-delay: 0.48s !important; }
    .delay-7 { transition-delay: 0.56s !important; }

    /* anel de pulso nos ícones ao entrar em cena */
    .diff-icon, .valor-icon, .mv-card-icon, .servico-icon, .software-icon { position: relative; }
    .diff-icon::after, .valor-icon::after, .mv-card-icon::after {
      content: ''; position: absolute; inset: 0; border-radius: inherit;
      border: 2px solid var(--olive-light); opacity: 0; transform: scale(1);
      pointer-events: none;
    }
    .revealed .diff-icon::after,
    .revealed .valor-icon::after,
    .revealed .mv-card-icon::after { animation: iconPulse 0.9s cubic-bezier(0.22,1,0.36,1) 0.15s 1; }
    @keyframes iconPulse {
      0%   { opacity: 0.65; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.55); }
    }

    @keyframes iconWobble {
      0%, 100% { transform: rotate(-8deg) scale(1.08); }
      50%      { transform: rotate(-15deg) scale(1.14); }
    }
    .diff-card:hover .diff-icon,
    .servico-panel:hover .servico-icon,
    .software-card:hover .software-icon,
    .mv-card:hover .mv-card-icon { animation: iconWobble 0.55s ease-in-out 1; }

    .btn-magnetic { transition: transform 0.12s ease-out, background 0.2s, border-color 0.2s; }
    .btn-magnetic.settling { transition: transform 0.45s cubic-bezier(0.22,1,0.36,1), background 0.2s, border-color 0.2s; }

    /* cortina de revelação sobre a imagem da seção sobre */
    .img-curtain {
      position: absolute; inset: 0; z-index: 5;
      background: linear-gradient(135deg, var(--teal), var(--olive));
      transform-origin: right; transform: scaleX(1);
      transition: transform 0.9s cubic-bezier(0.65,0,0.35,1);
      pointer-events: none;
    }
    .revealed .img-curtain { transform: scaleX(0); }
    @media (prefers-reduced-motion: reduce) { .img-curtain { transition: none; transform: scaleX(0); } }

    .servico-panel, .software-card, .diff-card, .mv-card { will-change: transform; }
    @media (max-width: 1024px) {
      .servico-panel, .software-card, .diff-card, .mv-card { will-change: auto; transform: none !important; }
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 1024px) {
      section           { padding: 72px 0; }
      .sobre-grid       { grid-template-columns: 1fr; gap: 40px; }
      .contato-grid     { grid-template-columns: 1fr; gap: 40px; }
      .servicos-grid    { grid-template-columns: 1fr; }
      .footer-grid      { grid-template-columns: 1fr 1fr; gap: 32px; }
      .footer-brand     { grid-column: 1 / -1; }
      .contato-form     { max-width: 680px; }
      /* fundo fixo (parallax) tem suporte instável em celulares (iOS Safari o ignora
         e alguns Android têm jank) — volta a rolar normalmente abaixo de 1024px */
      .hero, .sobre, .missao-visao, .servicos, .software, .diferenciais, .contato {
        background-attachment: scroll;
      }
    }

    @media (max-width: 1100px) {
      nav               { display: none; }
      .menu-toggle      { display: flex; }
    }

    @media (max-width: 900px) {
      .diff-grid        { grid-template-columns: 1fr 1fr; }
      .mv-grid          { grid-template-columns: 1fr; }
      .software-grid    { grid-template-columns: 1fr; }
      .form-row         { grid-template-columns: 1fr; }
    }

    @media (max-width: 640px) {
      .header-inner     { height: 72px; }
      .logo-link img    { height: 42px; }
      .logo-text strong { font-size: 1rem; }
      .mobile-nav       { top: 72px; padding: 12px 16px 20px; }
      .hero             { padding-top: 72px; }
      .hero-actions     { flex-direction: column; align-items: flex-start; }
      .diff-grid        { grid-template-columns: 1fr; }
      .valores-grid     { flex-direction: column; align-items: stretch; }
      .valor-card       { max-width: none; }
      .footer-grid      { grid-template-columns: 1fr; gap: 32px; }
      .contato-form     { padding: 32px 22px; }
      .back-to-top      { bottom: 20px; right: 84px; width: 42px; height: 42px; }
      .wa-float         { bottom: 20px; right: 20px; width: 50px; height: 50px; }
    }
  </style>
</head>
